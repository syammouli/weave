# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
lerna-lock.yaml

# ── Build output ──────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/

# ── Environment variables (never commit secrets / API URLs) ───────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
deployment/dev.env
deployment/*.env

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── TypeScript cache ──────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Test & coverage output ────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Vite / tooling cache ──────────────────────────────────────────────────────
.vite/
*.local

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/

# ── Editor directories ────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

